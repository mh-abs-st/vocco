{
  "name": "vocco",
  "version": "0.1.0",
  "private": true,
  "description": "Vocco: practise speaking out loud with a coach that listens.",
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm start --workspace apps/server",
    "test": "npm test --workspace packages/shared && npm test --workspace apps/server",
    "typecheck": "npm run typecheck --workspace apps/web"
  }
}
