# Copy to .env and fill in. Never commit .env.

PORT=8787

# Live speech-to-text (https://console.deepgram.com). Required for sessions.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Reports (https://console.anthropic.com). Required for the end-of-session report.
ANTHROPIC_API_KEY=
REPORT_MODEL=claude-sonnet-5-5

# Accounts and credits (Supabase, docs/SUPABASE.md). Leave empty to run without accounts.
SUPABASE_URL=
# Server key: Project settings → API Keys → Secret key (sb_secret_…). Never put it in the web app.
SUPABASE_SECRET_KEY=
# Browser key for sign-in: Project settings → API Keys → Publishable key (sb_publishable_…). Safe to expose.
SUPABASE_PUBLISHABLE_KEY=

# Free credits (once per browser / network / email): the key for the anonymous hashes. Set a long random value
# once in production and never change it (openssl rand -hex 32). Extra throwaway-email domains to refuse:
TRIAL_SECRET=
TRIAL_BLOCKED_DOMAINS=

# Comma-separated browser origins allowed to connect. Empty = any (local work only).
# Production example: https://vocco.app
ALLOWED_ORIGINS=

# Limits while there are no accounts yet
MAX_SESSION_MIN=10
MAX_SOCKETS_PER_IP=2
REPORTS_PER_HOUR_PER_IP=20

# 1 behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0

# Where the built web app is, relative to apps/server (empty = API only)
WEB_DIST=../web/dist

# 1 = also log one [usage] line per speech stream and report (costs are recorded in Supabase either way)
LOG_USAGE=0

# /admin/usage (cost, revenue, profit): only on this computer, password = ADMIN_TOKEN. Unset = no admin pages.
ADMIN_TOKEN=
